    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst departure = new Date($json['Departure Date']);\ndeparture.setHours(0, 0, 0, 0);\n\nconst returnDate = new Date($json['Return Date']);\nreturnDate.setHours(0, 0, 0, 0);\n\nconst daysToDeparture = Math.round((departure - today) / (1000 * 60 * 60 * 24));\nconst daysSinceReturn = Math.round((today - returnDate) / (1000 * 60 * 60 * 24));\n\nconst status = $json['Status'];\n\nlet route = 'skip';\nlet message = '';\nlet newStatus = status;\n\nif (daysToDeparture <= 3 && daysToDeparture >= 0 && status !== 'Pre-trip Sent' && status !== 'Completed') {\n  route = 'pre-trip';\n  message = `Hi ${$json['Name']}, your trip is almost here! Departure is on ${$json['Departure Date']}. Here's your checklist: pack your documents, confirm your pickup time, and charge your phone. Safe travels!`;\n  newStatus = 'Pre-trip Sent';\n} else if (daysSinceReturn === 1 && status !== 'Post-trip Sent' && status !== 'Completed') {\n  route = 'post-trip';\n  message = `Welcome back, ${$json['Name']}! Hope the trip was amazing. How was it? Reply and let us know, we'd love to hear.`;\n  newStatus = 'Post-trip Sent';\n}\n\nreturn {\n  ...$json,\n  daysToDeparture,\n  daysSinceReturn,\n  route,\n  message,\n  to: $json['WhatsApp Number'],\n  newStatus,\n  row_number: $itemIndex + 2\n};"
      },

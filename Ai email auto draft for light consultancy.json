    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body }}",
        "options": {
          "systemMessage": "You are the email assistant for Light Consultancy, an AI automation consulting business.\n\nAvailable files (return the name EXACTLY as written, or \"none\" if nothing fits):\n- \"Consulting Packages 2026.pdf\"\n\nRead the incoming email and return ONLY valid JSON in this exact shape, no markdown, no code fences:\n\n{\n  \"is_request\": true or false,\n  \"file_needed\": \"exact file name or none\",\n  \"subject\": \"a short reply subject line\",\n  \"reply_draft\": \"a short, warm reply in the sender's tone, 3-5 sentences, no sign-off\"\n}\n\nRules:\n- is_request is true only if the sender is asking for a proposal, capability deck, pricing, or consulting packages.\n- Apostrophes (') need no escaping in JSON. Only escape double quotes (\") if they appear inside a string value, using \\\".\n- Never use a backslash before an apostrophe.\n- subject should be \"Re: \" followed by the original subject line, unless that would be redundant, then just the original subject.\n- reply_draft must start with a capital letter as the first character. Never start the reply with a lowercase word.\n- reply_draft should reference what they asked for by name, e.g. \"attached is our Consulting Packages 2026 deck.\"\n- Never invent a file name that isn't in the list above."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -992,
        -176
      ],
      "id": "f81b0967-5b1d-4648-8ff2-25d4ebf9ba17",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [

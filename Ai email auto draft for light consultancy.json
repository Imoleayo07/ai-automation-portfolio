        48
      ],
      "id": "4d992598-13b3-4836-b8d9-456da42f3a8e",
      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": {
          "id": "kPyhTPX4D1rcCt1R",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Grab the AI node's raw output\nconst raw = $input.first().json.message?.content \n  || $input.first().json.text \n  || $input.first().json.output;\n\nif (!raw) {\n  throw new Error('No AI response found on this item. Check the AI node output field name.');\n}\n\n// Strip markdown fences if the model added them anyway\nlet cleaned = raw.trim().replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```$/i, '').trim();\n\n// Fix invalid \\' escapes that some models add despite instructions\ncleaned = cleaned.replace(/\\\\'/g, \"'\");\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (err) {\n  throw new Error(`AI response wasn't valid JSON: ${err.message}. Raw output: ${cleaned}`);\n}\n\n// Force capitalization as a backstop, in case the model doesn't follow the rule\nlet reply = parsed.reply_draft?.trim() || '';\nif (reply) {\n  reply = reply.charAt(0).toUpperCase() + reply.slice(1);\n}\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    is_request: parsed.is_request,\n    file_needed: parsed.file_needed?.trim(),\n    subject: parsed.subject?.trim(),\n    reply_draft: reply\n  }\n}];"
      },

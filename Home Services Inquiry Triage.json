              "name": "alert_text",
              "value": "=={{ \n'<h2>' + ($json.urgent ? '🚨 URGENT: ' : '') + 'New Inquiry (' + $json.action + ')</h2>' +\n'<p><b>From:</b> ' + $json.sender_name + '</p>' + +\n'<p><b>Action:</b> ' + $json.action + '</p>' +\n'<p><b>Deadline:</b> ' + ($json.deadline || 'none stated') + '</p>' +\n'<p><b>Preferred time:</b> ' + ($json.preferred_time || 'not specified') + '</p>' +\n'<p><b>Open questions:</b> ' + ($json.questions.length ? $json.questions.join('; ') : 'none') + '</p>' +\n'<p><b>Summary:</b> ' + $json.summary + '</p>' +\n'<hr><p style=\"color:#888;font-size:12px;\">Original message: ' + $json.rawMessage.replace(/\\n/g, '<br>') + '</p>'\n}}",
              "type": "string",
              "id": "d5a0c6a5-1a9d-4479-8cd1-aeff7f350275"

      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"llama-3.3-70b-versatile\",\n  max_tokens: 500,\n  temperature: 0.2,\n  response_format: { type: \"json_object\" },\n  messages: [\n    {\n      role: \"system\",\n      content: \"You triage inbound customer inquiries for a home services company. Return ONLY valid JSON matching this schema: {\\\"action\\\": string, \\\"deadline\\\": string or null, \\\"preferredtime/date\\\": string or null, \\\"questions\\\": array of strings, \\\"urgent\\\": boolean, \\\"summary\\\": one line under 15 words}.\"\n    },\n    {\n      role: \"user\",\n      content: $json.message\n    }\n  ]\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        416,
        96
      ],
      "id": "ccffcb42-cc16-49dd-9b3a-59535f4c17f5",
      "name": "AI model",
      "credentials": {
        "httpHeaderAuth": {
          "id": "G98CkeVkeOuRderK",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(cleaned);\n} catch (e) {\n  data = {\n    action: 'COULD NOT PARSE - review manually',\n    deadline: null,\n    preferred_time: null,\n    questions: [],\n    urgent: true,\n    summary: raw.slice(0, 200)\n  };\n}\n\nconst src = $('Merge Inputs').first().json;\n\nreturn [{\n  json: {\n    ...data,\n    sender: src.sender,\n    source: src.source,\n    receivedAt: src.receivedAt,\n    rawMessage: src.message\n  }\n}];"
      },
      "id": "b9330f13-3e68-46ac-badc-e8ae05996757",
